# Backend environment. Copy to backend/.env (never commit the real file).
# All values are optional; the defaults are shown.

# Port of the Express + Socket.IO server (src/main/server.ts).
PORT=5000

# Allowed CORS origin(s), comma separated. Use your frontend URL in production.
CORS_ORIGIN=*

# Port of the standalone 3D Game of Life WebSocket server (src/main/game-of-life-3d-server.ts).
WS_PORT=8081

# Python interpreter used for the NumPy Game of Life engine.
# Default: backend/venv/bin/python3 if it exists, otherwise python3 on PATH.
# PYTHON_PATH=/path/to/python3

# Path to the compiled C++ addon. Default:
# src/infrastructure/engine/cpp/build/Release/pacman_engine.node
# PACMAN_ENGINE_PATH=/path/to/pacman_engine.node
