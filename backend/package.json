{
  "name": "cv-web-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/main/server.ts",
    "dev": "tsx watch src/main/server.ts",
    "dev:3d": "tsx watch src/main/game-of-life-3d-server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "build:engine": "cd src/infrastructure/engine/cpp && node-gyp rebuild",
    "test": "vitest run",
    "test:py": "venv/bin/python -m pytest src/infrastructure/engine/python"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "node-addon-api": "^8.6.0",
    "socket.io": "^4.8.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.11.0",
    "@types/ws": "^8.18.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
