# Frontend environment (Vite). Copy to .env.local and adjust if the backend
# does not run on the same host with the default ports.

# Express + Socket.IO backend (npm start in backend/). Default: http://<page host>:5000
VITE_BACKEND_HTTP_URL=http://localhost:5000

# Plain WebSocket server for the 3D Game of Life (npm run dev:3d in backend/).
# Default: ws://<page host>:8081
VITE_BACKEND_WS_URL=ws://localhost:8081
